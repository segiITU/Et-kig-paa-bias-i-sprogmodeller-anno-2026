# Copy to .env and fill in your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Only needed if a model in config/experiment.yaml sets provider: odincore
# (ordbogen.ai's odin-2-large). Requires creating an org on ordbogen.ai first;
# the key must carry the right scope for the /responses and /chat/completions
# endpoints or calls fail with a 403 insufficient_permissions error.
ODINCORE_API_KEY=...
